<section class="service-hero-v5"><div class="container service-hero-grid"><div><span class="eyebrow"><i></i>{{ section.settings.kicker }}</span><h1>{{ section.settings.title }} <span>{{ section.settings.accent }}</span></h1><p class="lead">{{ section.settings.text }}</p><div class="hero-actions"><a class="btn btn-primary btn-large" href="{{ section.settings.primary_link | default:'/pages/order' }}">{{ section.settings.primary_label }} ←</a><a class="btn btn-outline btn-large" href="{{ section.settings.secondary_link | default:'/pages/contact' }}">{{ section.settings.secondary_label }}</a></div></div><aside class="service-visual-v8"><div class="service-media-v8">{% render 'service-image-fallback', service_key: section.settings.kicker, alt: section.settings.title, loading: 'eager' %}</div><div class="service-price-card"><small>{{ section.settings.price_label }}</small><strong>{{ section.settings.price }}</strong><p>{{ section.settings.price_note }}</p><ul>{% assign points=section.settings.quick_points | newline_to_br | split:'<br />' %}{% for point in points %}{% if point != blank %}<li>✓ {{ point }}</li>{% endif %}{% endfor %}</ul></div></aside></div></section>
<section class="service-details-v5"><div class="container"><div class="section-head"><span class="kicker">{{ section.settings.features_kicker }}</span><h2>{{ section.settings.features_title }}</h2><p>{{ section.settings.features_text }}</p></div><div class="feature-grid-v5">{% for block in section.blocks %}<article class="feature-card-v5" {{ block.shopify_attributes }}><span>{{ block.settings.icon }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div><div class="deliverables-v5"><div><span class="kicker">ما الذي ستحصل عليه؟</span><h2>{{ section.settings.deliverables_title }}</h2></div><ul>{% assign items=section.settings.deliverables | newline_to_br | split:'<br />' %}{% for item in items %}{% if item != blank %}<li>{{ item }}</li>{% endif %}{% endfor %}</ul></div>{% if page.content != blank %}<div class="rte service-rte">{{ page.content }}</div>{% endif %}</div></section>
{% schema %}
{"name":"صفحة خدمة Qabs1","settings":[{"type":"text","id":"kicker","label":"الشارة","default":"خدمة Qabs1"},{"type":"text","id":"title","label":"العنوان","default":"حل عملي يبدأ من"},{"type":"text","id":"accent","label":"الكلمة المميزة","default":"احتياجك."},{"type":"textarea","id":"text","label":"الوصف","default":"خدمة منظمة بنطاق واضح وتسليمات يمكن متابعتها."},{"type":"text","id":"primary_label","label":"الزر الرئيسي","default":"ابدأ الطلب"},{"type":"url","id":"primary_link","label":"رابط الزر الرئيسي"},{"type":"text","id":"secondary_label","label":"الزر الثانوي","default":"تحدث معنا"},{"type":"url","id":"secondary_link","label":"رابط الزر الثانوي"},{"type":"text","id":"price_label","label":"عنوان السعر","default":"يبدأ من"},{"type":"text","id":"price","label":"السعر","default":"$49"},{"type":"textarea","id":"price_note","label":"ملاحظة السعر","default":"السعر النهائي يعتمد على النطاق والإضافات."},{"type":"textarea","id":"quick_points","label":"نقاط سريعة","default":"نطاق واضح\nمتابعة منظمة\nتسليم قابل للمراجعة"},{"type":"text","id":"features_kicker","label":"شارة المزايا","default":"نطاق الخدمة"},{"type":"text","id":"features_title","label":"عنوان المزايا","default":"كل ما تحتاجه للبدء بثقة"},{"type":"textarea","id":"features_text","label":"وصف المزايا","default":"اختر الباقة ثم خصصها وفق احتياج مشروعك."},{"type":"text","id":"deliverables_title","label":"عنوان التسليمات","default":"تسليمات واضحة من البداية"},{"type":"textarea","id":"deliverables","label":"التسليمات","default":"مراجعة الاحتياج\nخطة تنفيذ\nالتسليم النهائي\nدعم ما بعد التسليم"}],"blocks":[{"type":"feature","name":"ميزة","settings":[{"type":"text","id":"icon","label":"الأيقونة","default":"✓"},{"type":"text","id":"title","label":"العنوان","default":"نطاق واضح"},{"type":"textarea","id":"text","label":"الوصف","default":"تعرف ما يشمله الطلب قبل الدفع."}]}],"max_blocks":6,"presets":[{"name":"صفحة خدمة Qabs1","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}
{% endschema %}
