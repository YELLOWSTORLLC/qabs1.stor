<section class="hero" id="top"><div class="container hero-grid">
  <div class="hero-copy"><div class="eyebrow"><i></i>{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading | replace: '[', '<span>' | replace: ']', '</span>' }}</h1>
    <p class="lead">{{ section.settings.text }}</p>
    <div class="hero-actions"><a class="btn btn-primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} <span>←</span></a><a class="btn btn-outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div>
    <div class="trust-row"><div class="avatars"><span class="avatar a1">م</span><span class="avatar a2">س</span><span class="avatar a3">ر</span><span class="avatar a4">ن</span></div><span><b>{{ section.settings.trust_number }}</b> {{ section.settings.trust_text }}</span></div>
  </div>
  <div class="hero-visual"><div class="dashboard"><div class="dash-top"><div class="dash-title"><strong>{{ section.settings.dashboard_title }}</strong>{{ section.settings.dashboard_subtitle }}</div><div class="dash-user">ق</div></div><div class="dash-grid"><div class="metric"><small>حالة الشركة</small><strong class="teal">نشطة</strong><span class="up">● ملتزمة</span></div><div class="metric"><small>المهام القادمة</small><strong>04</strong><span class="up">هذا الشهر</span></div><div class="chart"><div class="chart-head"><b>نمو نشاطك</b><span>آخر 7 أشهر</span></div><div class="bars"><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i></div></div></div></div><div class="task"><div class="task-head"><span class="check">✓</span> تذكير مهم</div><p>موعد تقديم التقرير السنوي بعد 12 يومًا.</p></div></div>
</div></section>
{% schema %}
{"name":"Hero Qabs1","settings":[{"type":"text","id":"eyebrow","label":"الشارة","default":"منصة أعمال ذكية لأصحاب المشاريع"},{"type":"textarea","id":"heading","label":"العنوان (استخدم [كلمة] لتلوينها)","default":"حوّل فكرتك إلى [عمل جاهز للنمو.]"},{"type":"textarea","id":"text","label":"الوصف","default":"من تأسيس شركتك إلى إدارة التزاماتها اليومية، يجمع Qabs1 كل ما تحتاجه لتبدأ بثقة وتبقى منظمًا وتتحرك أسرع."},{"type":"text","id":"primary_label","label":"الزر الأساسي","default":"استكشف الباقات"},{"type":"url","id":"primary_link","label":"رابط الزر الأساسي"},{"type":"text","id":"secondary_label","label":"الزر الثانوي","default":"شاهد الخدمات"},{"type":"url","id":"secondary_link","label":"رابط الزر الثانوي"},{"type":"text","id":"trust_number","label":"رقم الثقة","default":"+2,500"},{"type":"text","id":"trust_text","label":"نص الثقة","default":"صاحب مشروع بدأ معنا"},{"type":"text","id":"dashboard_title","label":"عنوان اللوحة","default":"لوحة أعمالك"},{"type":"text","id":"dashboard_subtitle","label":"وصف اللوحة","default":"نظرة سريعة على كل شيء"}],"presets":[{"name":"Hero Qabs1"}]}
{% endschema %}
