<section class="services" id="services"><div class="container"><div class="section-head"><div class="kicker">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="service-grid">{% for block in section.blocks %}<article class="service-card" {{ block.shopify_attributes }}><a class="service-card-image" href="{{ block.settings.link | default: '#' }}">{% render 'service-image-fallback', service_key: block.settings.title, alt: block.settings.title %}</a><div class="service-icon {{ block.settings.color_class }}">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">اعرف أكثر ←</a>{% endif %}</article>{% endfor %}</div></div></section>
{% schema %}{"name":"شبكة خدمات Qabs1","settings":[{"type":"text","id":"kicker","label":"العنوان الصغير","default":"كل ما تحتاجه"},{"type":"text","id":"heading","label":"العنوان","default":"خدمات عملية، بدون تعقيد"},{"type":"textarea","id":"text","label":"الوصف","default":"ابدأ من المكان الذي أنت فيه الآن، واختر فقط الخدمات التي تحتاجها فعلًا."}],"blocks":[{"type":"service","name":"خدمة","settings":[{"type":"text","id":"icon","label":"الأيقونة","default":"✦"},{"type":"select","id":"color_class","label":"لون الأيقونة","options":[{"value":"s1","label":"أخضر"},{"value":"s2","label":"برتقالي"},{"value":"s3","label":"أزرق"},{"value":"s4","label":"مرجاني"}],"default":"s1"},{"type":"text","id":"title","label":"العنوان","default":"تأسيس الشركات"},{"type":"textarea","id":"text","label":"الوصف","default":"جهّز كيانك التجاري ومستنداته الأساسية بخطوات واضحة ومنظمة."},{"type":"url","id":"link","label":"رابط الخدمة"}]}],"presets":[{"name":"شبكة خدمات Qabs1","blocks":[{"type":"service"},{"type":"service"},{"type":"service"},{"type":"service"}]}]}{% endschema %}
