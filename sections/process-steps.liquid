<section class="process" id="process"><div class="container"><div class="section-head"><div class="kicker">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="process-grid">{% for block in section.blocks %}<article class="step" {{ block.shopify_attributes }}><div class="step-num">{{ block.settings.number }} / {{ block.settings.label }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Process Steps","settings":[{"type":"text","id":"kicker","label":"العنوان الصغير","default":"ببساطة"},{"type":"text","id":"heading","label":"العنوان","default":"من الفكرة إلى الإنجاز في 3 خطوات"},{"type":"textarea","id":"text","label":"الوصف","default":"تجربة واضحة ومباشرة، مع دعم بشري عندما تحتاجه."}],"blocks":[{"type":"step","name":"خطوة","settings":[{"type":"text","id":"number","label":"الرقم","default":"01"},{"type":"text","id":"label","label":"التسمية","default":"أخبرنا عنك"},{"type":"text","id":"title","label":"العنوان","default":"شارك احتياجك"},{"type":"textarea","id":"text","label":"الوصف","default":"أجب عن أسئلة بسيطة عن نشاطك وأهدافك، وسنحدد المسار المناسب."}]}],"presets":[{"name":"Process Steps","blocks":[{"type":"step","settings":{"number":"01","label":"أخبرنا عنك","title":"شارك احتياجك"}},{"type":"step","settings":{"number":"02","label":"اختر ما يناسبك","title":"قارن واختر"}},{"type":"step","settings":{"number":"03","label":"تابع كل شيء","title":"ابقَ على اطلاع"}}]}]}
{% endschema %}
