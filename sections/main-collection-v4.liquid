<section class="collection-v4"><div class="container"><div class="page-head"><span class="kicker">خدمات Qabs1</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div>{{ collection.description }}</div>{% endif %}</div><div class="collection-toolbar"><span>{{ collection.products_count }} خدمة</span><select onchange="location.href=this.value"><option value="{{ collection.url }}?sort_by=manual">الموصى بها</option><option value="{{ collection.url }}?sort_by=price-ascending">السعر: الأقل أولًا</option><option value="{{ collection.url }}?sort_by=price-descending">السعر: الأعلى أولًا</option></select></div><div class="product-grid-v4">{% paginate collection.products by section.settings.per_page %}{% for product in collection.products %}<article class="shop-card"><a href="{{ product.url }}" class="shop-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.title }}{% else %}{% render 'product-image-fallback', product_handle: product.handle, product_title: product.title, alt: product.title %}{% endif %}</a><small>{{ product.type | default: 'خدمة Qabs1' }}</small><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><strong>{{ product.price | money }}</strong><a class="btn btn-outline card-btn" href="{{ product.url }}">عرض الخدمة</a></article>{% else %}<p>لا توجد منتجات في هذه المجموعة بعد.</p>{% endfor %}{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></section>
{% schema %}{"name":"مجموعة المنتجات Qabs1","settings":[{"type":"range","id":"per_page","label":"منتجات لكل صفحة","min":8,"max":24,"step":4,"default":12}],"presets":[{"name":"مجموعة المنتجات Qabs1"}]}{% endschema %}
