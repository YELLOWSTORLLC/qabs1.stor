<section class="offer-packages-v7"><div class="container"><div class="section-head"><span class="kicker">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="package-group-v7"><div class="package-group-head"><h3>باقات تأسيس الشركات</h3><a href="{{ section.settings.formation_link | default:'/pages/formation' }}">التفاصيل ورسوم الولايات ←</a></div><div class="package-grid-v7">{% for block in section.blocks %}{% if block.settings.group == 'formation' %}<article class="package-card-v7 {% if block.settings.featured %}featured{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.featured %}<span class="badge">الأكثر طلبًا</span>{% endif %}<small>{{ block.settings.subtitle }}</small><h4>{{ block.settings.title }}</h4><strong>{{ block.settings.price }}</strong><p>{{ block.settings.note }}</p><ul>{% assign fs=block.settings.features | newline_to_br | split:'<br />' %}{% for f in fs %}{% if f != blank %}<li>{{ f }}</li>{% endif %}{% endfor %}</ul><a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %}" href="{{ block.settings.link | default:'/pages/order' }}">اختر الباقة</a></article>{% endif %}{% endfor %}</div></div><div class="package-group-v7"><div class="package-group-head"><h3>باقات متاجر Shopify</h3><a href="{{ section.settings.store_link | default:'/pages/shopify-stores' }}">تفاصيل التجهيز والإضافات ←</a></div><div class="package-grid-v7">{% for block in section.blocks %}{% if block.settings.group == 'store' %}<article class="package-card-v7 {% if block.settings.featured %}featured{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.featured %}<span class="badge">الأكثر طلبًا</span>{% endif %}<small>{{ block.settings.subtitle }}</small><h4>{{ block.settings.title }}</h4><strong>{{ block.settings.price }}</strong><p>{{ block.settings.note }}</p><ul>{% assign fs=block.settings.features | newline_to_br | split:'<br />' %}{% for f in fs %}{% if f != blank %}<li>{{ f }}</li>{% endif %}{% endfor %}</ul><a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %}" href="{{ block.settings.link | default:'/pages/order' }}">اختر الباقة</a></article>{% endif %}{% endfor %}</div></div><p class="pricing-disclaimer-v7">رسوم الولايات، خطة Shopify، التطبيقات، الدومين، بوابات الدفع، الشحن، والجهات الخارجية ليست مشمولة إلا إذا ذُكر ذلك صراحة. يتم تأكيد النطاق والسعر قبل التنفيذ.</p></div></section>
{% schema %}{"name":"عروض Qabs1 الواضحة","settings":[{"type":"text","id":"kicker","label":"الشارة","default":"أسعار مقترحة وواضحة"},{"type":"text","id":"heading","label":"العنوان","default":"اختر الباقة المناسبة قبل إرسال الطلب"},{"type":"textarea","id":"text","label":"الوصف","default":"اعرف أتعاب Qabs1 أولًا، ثم أضف الرسوم الحكومية أو الخارجية عند الحاجة."},{"type":"url","id":"formation_link","label":"رابط التأسيس"},{"type":"url","id":"store_link","label":"رابط المتاجر"}],"blocks":[{"type":"package","name":"باقة","settings":[{"type":"select","id":"group","label":"الفئة","options":[{"value":"formation","label":"تأسيس"},{"value":"store","label":"متجر"}],"default":"formation"},{"type":"text","id":"subtitle","label":"الوصف القصير","default":"للبداية"},{"type":"text","id":"title","label":"الاسم","default":"Starter"},{"type":"text","id":"price","label":"السعر","default":"$49 + رسوم الولاية"},{"type":"textarea","id":"note","label":"الملاحظة","default":"أتعاب Qabs1؛ الرسوم الخارجية منفصلة."},{"type":"textarea","id":"features","label":"المزايا","default":"مراجعة البيانات\nتجهيز الطلب\nمتابعة الحالة"},{"type":"checkbox","id":"featured","label":"مميز","default":false},{"type":"url","id":"link","label":"الرابط"}]}],"max_blocks":6,"presets":[{"name":"عروض Qabs1 الواضحة","blocks":[{"type":"package"},{"type":"package"},{"type":"package"},{"type":"package"},{"type":"package"},{"type":"package"}]}]}{% endschema %}
