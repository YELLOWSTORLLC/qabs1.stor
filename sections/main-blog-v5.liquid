<section class="blog-v5"><div class="container"><div class="page-head"><span class="kicker">المعرفة</span><h1>{{ blog.title }}</h1></div><div class="article-grid-v5">{% paginate blog.articles by section.settings.per_page %}{% for article in blog.articles %}<article class="article-card-v5"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width:900 | image_tag: loading:'lazy', alt:article.title }}{% endif %}<small>{{ article.published_at | date:'%Y/%m/%d' }}</small><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate:150 }}</p></a></article>{% endfor %}{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></section>
{% schema %}{"name":"مدونة Qabs1","settings":[{"type":"range","id":"per_page","label":"مقالات لكل صفحة","min":6,"max":18,"step":3,"default":9}],"presets":[{"name":"مدونة Qabs1"}]}{% endschema %}
