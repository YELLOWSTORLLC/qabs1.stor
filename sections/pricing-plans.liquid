<section class="pricing" id="pricing"><div class="container"><div class="section-head"><div class="kicker">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="price-wrap">{% for block in section.blocks %}<article class="price-card {% if block.settings.featured %}featured{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.featured %}<div class="badge">{{ block.settings.badge }}</div>{% endif %}<h3>{{ block.settings.title }}</h3><p class="desc">{{ block.settings.description }}</p><div class="price">{{ block.settings.price }} <small>{{ block.settings.currency }}</small></div><ul class="features">{% assign features = block.settings.features | newline_to_br | split: '<br />' %}{% for feature in features %}{% if feature != blank %}<li>{{ feature }}</li>{% endif %}{% endfor %}</ul><a href="{{ block.settings.link }}" class="btn {% if block.settings.featured %}btn-primary{% else %}btn-outline{% endif %}" style="width:100%">{{ block.settings.button_label }}</a></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Pricing Plans","settings":[{"type":"text","id":"kicker","label":"العنوان الصغير","default":"باقات مرنة"},{"type":"text","id":"heading","label":"العنوان","default":"ابدأ بالأساسيات، وتوسع وقتما تشاء"},{"type":"textarea","id":"text","label":"الوصف","default":"أسعار واضحة بدون مفاجآت. يمكن تخصيص كل باقة حسب بلدك ونوع نشاطك."}],"blocks":[{"type":"plan","name":"باقة","settings":[{"type":"text","id":"title","label":"اسم الباقة","default":"البداية"},{"type":"textarea","id":"description","label":"الوصف","default":"لمن يريد ترتيب الخطوات الأولى بنفسه."},{"type":"text","id":"price","label":"السعر","default":"49"},{"type":"text","id":"currency","label":"العملة","default":"دولار"},{"type":"textarea","id":"features","label":"المزايا (كل ميزة في سطر)","default":"مراجعة أولية للاحتياج\nقائمة خطوات مخصصة\nقوالب ومستندات أساسية"},{"type":"checkbox","id":"featured","label":"باقة مميزة","default":false},{"type":"text","id":"badge","label":"شارة الباقة","default":"الأكثر طلبًا"},{"type":"text","id":"button_label","label":"الزر","default":"اختر الباقة"},{"type":"url","id":"link","label":"الرابط"}]}],"presets":[{"name":"Pricing Plans","blocks":[{"type":"plan","settings":{"title":"البداية","price":"49"}},{"type":"plan","settings":{"title":"الأساسي","price":"149","featured":true}},{"type":"plan","settings":{"title":"النمو","price":"249"}}]}]}
{% endschema %}
