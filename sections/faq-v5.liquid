<section class="faq-v5"><div class="container"><div class="section-head"><span class="kicker">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="faq-list-v5">{% for block in section.blocks %}<details {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}><summary>{{ block.settings.question }}<span>+</span></summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"الأسئلة الشائعة Qabs1","settings":[{"type":"text","id":"kicker","label":"الشارة","default":"قبل أن تبدأ"},{"type":"text","id":"heading","label":"العنوان","default":"أسئلة شائعة"},{"type":"textarea","id":"text","label":"الوصف","default":"إجابات مختصرة على أهم الأسئلة قبل الطلب."}],"blocks":[{"type":"question","name":"سؤال","settings":[{"type":"text","id":"question","label":"السؤال","default":"كيف أبدأ؟"},{"type":"richtext","id":"answer","label":"الإجابة","default":"<p>اختر الخدمة ثم أرسل تفاصيلك، وسنراجع النطاق قبل بدء التنفيذ.</p>"}]}],"max_blocks":12,"presets":[{"name":"الأسئلة الشائعة Qabs1","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
