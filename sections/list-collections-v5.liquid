<section class="collection-v4"><div class="container"><div class="page-head"><span class="kicker">الكتالوج</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div><div class="collection-grid-v5">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<article class="collection-card-v5"><a href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width:800 | image_tag: loading:'lazy', alt:collection.title }}{% else %}<div class="collection-placeholder">{{ collection.title | slice:0 }}</div>{% endif %}<h2>{{ collection.title }}</h2><p>{{ collection.products_count }} خدمة أو منتج</p></a></article>{% endunless %}{% endfor %}</div></div></section>
{% schema %}{"name":"كل المجموعات Qabs1","settings":[{"type":"text","id":"heading","label":"العنوان","default":"تصفح مجموعات الخدمات"},{"type":"textarea","id":"text","label":"الوصف","default":"اختر الفئة ثم قارن المنتجات والباقات المتاحة."}],"presets":[{"name":"كل المجموعات Qabs1"}]}{% endschema %}
