<section class="account-v5"><div class="container account-shell-v5"><div class="account-card-v5"><span class="kicker">أمان الحساب</span>{% if section.settings.mode == 'activate' %}<h1>تفعيل الحساب</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<label>كلمة المرور<input type="password" name="customer[password]" required autocomplete="new-password"></label><label>تأكيد كلمة المرور<input type="password" name="customer[password_confirmation]" required autocomplete="new-password"></label><button class="btn btn-primary" type="submit">تفعيل الحساب</button><button class="btn btn-outline" type="submit" name="decline">رفض الدعوة</button>{% endform %}{% else %}<h1>إعادة تعيين كلمة المرور</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<label>كلمة المرور الجديدة<input type="password" name="customer[password]" required autocomplete="new-password"></label><label>تأكيد كلمة المرور<input type="password" name="customer[password_confirmation]" required autocomplete="new-password"></label><button class="btn btn-primary" type="submit">حفظ كلمة المرور</button>{% endform %}{% endif %}</div></div></section>
{% schema %}{"name":"استعادة حساب العميل","settings":[{"type":"select","id":"mode","label":"الوضع","options":[{"value":"reset","label":"إعادة تعيين"},{"value":"activate","label":"تفعيل الحساب"}],"default":"reset"}],"presets":[{"name":"استعادة حساب العميل"}]}{% endschema %}
