<section class="contact-v4"><div class="container"><div class="section-head"><span class="kicker">تواصل معنا</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div><div class="contact-layout"><aside><h2>معلومات التواصل</h2><p>{{ section.settings.side_text }}</p>{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{% endif %}{% if section.settings.whatsapp != blank %}<a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}">WhatsApp: {{ section.settings.whatsapp }}</a>{% endif %}</aside><div>{% form 'contact', class: 'contact-form-v4' %}{% if form.posted_successfully? %}<p class="form-success">تم إرسال رسالتك بنجاح.</p>{% endif %}{{ form.errors | default_errors }}<div class="form-grid-v4"><label>الاسم<input required name="contact[name]" value="{{ form.name }}"></label><label>البريد<input required type="email" name="contact[email]" value="{{ form.email }}"></label><label>الهاتف<input name="contact[phone]" value="{{ form.phone }}"></label><label>نوع الخدمة<select name="contact[service]"><option>تأسيس شركة</option><option>متجر Shopify</option><option>إدارة متجر</option><option>سوشل ميديا</option><option>حل رقمي</option><option>طلب مخصص</option></select></label></div><label>تفاصيل الطلب<textarea required name="contact[body]">{{ form.body }}</textarea></label><button class="btn btn-primary btn-large" type="submit">إرسال الرسالة ←</button>{% endform %}</div></div></div></section>
{% schema %}{"name":"تواصل Qabs1","settings":[{"type":"text","id":"heading","label":"العنوان","default":"كيف يمكننا مساعدتك؟"},{"type":"textarea","id":"text","label":"الوصف","default":"أرسل تفاصيلك وسنحدد الخدمة المناسبة قبل الدفع."},{"type":"textarea","id":"side_text","label":"النص الجانبي","default":"فريق Qabs1 يراجع الطلبات ويرد خلال أوقات العمل."},{"type":"text","id":"email","label":"البريد"},{"type":"text","id":"whatsapp","label":"رقم WhatsApp"}],"presets":[{"name":"تواصل Qabs1"}]}{% endschema %}
