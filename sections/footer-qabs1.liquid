<footer class="footer"><div class="container footer-grid">
 <div class="footer-brand"><a class="brand inverse" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 320 | image_tag: class:'brand-image footer-logo', alt: settings.brand_name | default: shop.name }}{% else %}<span class="logo"></span><span>{{ settings.brand_name | default: section.settings.brand_name }}</span>{% endif %}</a><p>{{ section.settings.description }}</p><div class="social-row">{% if settings.instagram %}<a href="{{ settings.instagram }}">Instagram</a>{% endif %}{% if settings.x_twitter %}<a href="{{ settings.x_twitter }}">X</a>{% endif %}{% if settings.linkedin %}<a href="{{ settings.linkedin }}">LinkedIn</a>{% endif %}</div></div>
 {% for block in section.blocks %}<div {{ block.shopify_attributes }}><h4>{{ block.settings.title }}</h4>{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% endif %}</div>{% endfor %}
 <div class="footer-newsletter"><h4>{{ section.settings.newsletter_title }}</h4><p>{{ section.settings.newsletter_text }}</p>{% form 'customer', class:'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">البريد الإلكتروني</label><input id="FooterEmail" type="email" name="contact[email]" required placeholder="بريدك الإلكتروني"><button class="btn btn-primary" type="submit">اشترك</button>{% endform %}</div>
</div><div class="container footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. جميع الحقوق محفوظة.</span><span>{{ section.settings.note }}</span></div></footer>
{% schema %}
{"name":"تذييل Qabs1 الكامل","settings":[{"type":"text","id":"brand_name","label":"اسم العلامة","default":"Qabs1"},{"type":"textarea","id":"description","label":"الوصف","default":"منصة عربية تجمع تأسيس وتشغيل ونمو الأعمال في رحلة واحدة واضحة."},{"type":"text","id":"newsletter_title","label":"عنوان النشرة","default":"ابقَ على اطلاع"},{"type":"textarea","id":"newsletter_text","label":"وصف النشرة","default":"نصائح عملية وعروض جديدة بدون إزعاج."},{"type":"text","id":"note","label":"الملاحظة","default":"الرسوم الحكومية ورسوم الجهات الخارجية قابلة للتغيير."}],"blocks":[{"type":"menu","name":"عمود روابط","settings":[{"type":"text","id":"title","label":"العنوان","default":"روابط"},{"type":"link_list","id":"menu","label":"القائمة"}]}],"max_blocks":3,"presets":[{"name":"تذييل Qabs1 الكامل","blocks":[{"type":"menu"},{"type":"menu"}]}]}
{% endschema %}
