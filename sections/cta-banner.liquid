<section class="cta" id="contact"><div class="container"><div class="cta-box"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><a class="btn btn-light" href="{{ section.settings.link }}">{{ section.settings.button_label }} <span>←</span></a></div></div></section>
{% schema %}
{"name":"CTA Banner","settings":[{"type":"text","id":"heading","label":"العنوان","default":"جاهز تبدأ بشكل صحيح؟"},{"type":"textarea","id":"text","label":"الوصف","default":"اترك بياناتك وسيتواصل معك مستشار Qabs1 لمساعدتك في اختيار المسار الأنسب."},{"type":"text","id":"button_label","label":"نص الزر","default":"احجز استشارتك المجانية"},{"type":"url","id":"link","label":"الرابط"}],"presets":[{"name":"CTA Banner"}]}
{% endschema %}
