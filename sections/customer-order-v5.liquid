<section class="account-v5"><div class="container"><div class="account-head-v5"><div><span class="kicker">تفاصيل الطلب</span><h1>{{ order.name }}</h1><p>{{ order.created_at | date:'%Y/%m/%d' }}</p></div><a class="btn btn-outline" href="{{ routes.account_url }}">كل الطلبات</a></div><div class="order-detail-v5"><div>{% for line_item in order.line_items %}<article><div>{% if line_item.image %}{{ line_item.image | image_url: width:160 | image_tag: alt:line_item.title }}{% endif %}</div><div><h2>{{ line_item.title }}</h2><p>الكمية: {{ line_item.quantity }}</p></div><strong>{{ line_item.final_line_price | money }}</strong></article>{% endfor %}</div><aside><h2>ملخص الطلب</h2><p><span>الإجمالي</span><b>{{ order.total_price | money }}</b></p><p><span>الدفع</span><b>{{ order.financial_status_label }}</b></p><p><span>التنفيذ</span><b>{{ order.fulfillment_status_label }}</b></p></aside></div></div></section>
{% schema %}{"name":"طلب العميل Qabs1","settings":[],"presets":[{"name":"طلب العميل Qabs1"}]}{% endschema %}
