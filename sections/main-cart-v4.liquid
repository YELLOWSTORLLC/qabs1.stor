<section class="cart-v4"><div class="container"><div class="page-head"><span class="kicker">مراجعة الطلب</span><h1>سلة الخدمات</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-layout"><div class="cart-items">{% for item in cart.items %}<article class="cart-item"><div>{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.product.title }}{% endif %}</div><div><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3><small>{{ item.variant.title }}</small><a class="remove-link" href="{{ item.url_to_remove }}">إزالة</a></div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="الكمية"><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><aside class="cart-summary"><h2>ملخص الطلب</h2><p><span>الإجمالي</span><b>{{ cart.total_price | money }}</b></p><small>الرسوم الحكومية أو رسوم الجهات الخارجية تظهر كمنتجات أو خيارات منفصلة عند إعدادها.</small><button class="btn btn-outline" type="submit" name="update">تحديث السلة</button><button class="btn btn-primary btn-large" type="submit" name="checkout">الانتقال للدفع الآمن</button></aside></div></form>{% else %}<div class="empty-cart"><h2>سلتك فارغة</h2><p>استكشف خدمات Qabs1 واختر الباقة المناسبة.</p><a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">استكشف الخدمات</a></div>{% endif %}</div></section>
{% schema %}{"name":"سلة Qabs1","settings":[],"presets":[{"name":"سلة Qabs1"}]}{% endschema %}
