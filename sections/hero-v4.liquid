<section class="hero hero-v4"><div class="container hero-grid">
  <div class="hero-copy"><div class="eyebrow"><i></i>{{ section.settings.eyebrow }}</div><h1>{{ section.settings.title_before }} <span>{{ section.settings.title_accent }}</span></h1><p class="lead">{{ section.settings.text }}</p><div class="hero-actions"><a class="btn btn-primary btn-large" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} ←</a><a class="btn btn-outline btn-large" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div><div class="trust-row"><div class="avatars"><span class="avatar a1">ق</span><span class="avatar a2">م</span><span class="avatar a3">س</span><span class="avatar a4">ن</span></div><b>{{ section.settings.trust_number }}</b><span>{{ section.settings.trust_text }}</span></div></div>
  <div class="hero-visual"><div class="dashboard"><div class="dash-top"><div class="dash-title"><strong>لوحة أعمالك</strong>نظرة سريعة على كل شيء</div><div class="dash-user">ق</div></div><div class="dash-grid"><div class="metric"><small>حالة الشركة</small><strong class="teal">نشطة</strong><span class="up">● ملتزمة</span></div><div class="metric"><small>المهام القادمة</small><strong>04</strong><span class="up">هذا الشهر</span></div><div class="chart"><div class="chart-head"><b>نمو نشاطك</b><span>آخر 7 أشهر</span></div><div class="bars">{% for i in (1..7) %}<i class="bar"></i>{% endfor %}</div></div></div></div><div class="task"><div class="task-head"><span class="check">✓</span> تذكير مهم</div><p>موعد التقرير السنوي بعد 12 يومًا.</p></div></div>
</div></section>
{% schema %}
{"name":"واجهة Qabs1 الجديدة","settings":[{"type":"text","id":"eyebrow","label":"الشارة","default":"منصة أعمال ذكية لأصحاب المشاريع"},{"type":"text","id":"title_before","label":"العنوان","default":"حوّل فكرتك إلى"},{"type":"text","id":"title_accent","label":"النص الملون","default":"عمل جاهز للنمو."},{"type":"textarea","id":"text","label":"الوصف","default":"من تأسيس شركتك إلى إدارة المتجر والتسويق والامتثال، يجمع Qabs1 كل ما تحتاجه لتبدأ بثقة وتبقى منظمًا."},{"type":"text","id":"primary_label","label":"الزر الرئيسي","default":"احسب تكلفتك الآن"},{"type":"url","id":"primary_link","label":"رابط الزر الرئيسي"},{"type":"text","id":"secondary_label","label":"الزر الثاني","default":"استكشف الخدمات"},{"type":"url","id":"secondary_link","label":"رابط الزر الثاني"},{"type":"text","id":"trust_number","label":"رقم الثقة","default":"+2,500"},{"type":"text","id":"trust_text","label":"نص الثقة","default":"صاحب مشروع بدأ معنا"}],"presets":[{"name":"واجهة Qabs1 الجديدة"}]}
{% endschema %}
