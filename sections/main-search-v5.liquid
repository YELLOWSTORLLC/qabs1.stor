<section class="search-v5"><div class="container"><div class="page-head"><span class="kicker">بحث المتجر</span><h1>ابحث في Qabs1</h1></div><form action="{{ routes.search_url }}" method="get" class="search-form-v5"><label class="visually-hidden" for="SearchInput">عبارة البحث</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="ابحث عن خدمة أو باقة"><input type="hidden" name="type" value="product,page,article"><button class="btn btn-primary" type="submit">بحث</button></form>{% if search.performed %}<p class="search-count">{{ search.results_count }} نتيجة لعبارة “{{ search.terms }}”</p><div class="search-results-v5">{% paginate search.results by 18 %}{% for item in search.results %}<article><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width:500 | image_tag: loading:'lazy', alt:item.title }}{% endif %}<small>{{ item.object_type }}</small><h2>{{ item.title }}</h2><p>{{ item.content | strip_html | truncate:120 }}</p></a></article>{% else %}<div class="empty-catalog">لم نجد نتائج. جرّب كلمات أقصر أو تصفح جميع الخدمات.</div>{% endfor %}{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div>{% endif %}</div></section>
{% schema %}{"name":"بحث Qabs1","settings":[],"presets":[{"name":"بحث Qabs1"}]}{% endschema %}
