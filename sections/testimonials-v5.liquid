<section class="testimonials-v5"><div class="container"><div class="section-head"><span class="kicker">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="testimonial-grid-v5">{% for block in section.blocks %}<blockquote {{ block.shopify_attributes }}><div class="quote-mark">“</div><p>{{ block.settings.quote }}</p><footer><strong>{{ block.settings.name }}</strong><span>{{ block.settings.role }}</span></footer></blockquote>{% endfor %}</div></div></section>
{% schema %}{"name":"آراء العملاء Qabs1","settings":[{"type":"text","id":"kicker","label":"الشارة","default":"ثقة العملاء"},{"type":"text","id":"heading","label":"العنوان","default":"تجربة أبسط من البداية"},{"type":"textarea","id":"text","label":"الوصف","default":"استبدل النصوص التالية بآراء موثقة من عملائك."}],"blocks":[{"type":"quote","name":"رأي","settings":[{"type":"textarea","id":"quote","label":"النص","default":"كانت الخطوات واضحة والمتابعة منظمة من أول يوم."},{"type":"text","id":"name","label":"الاسم","default":"عميل Qabs1"},{"type":"text","id":"role","label":"الصفة","default":"صاحب مشروع"}]}],"max_blocks":6,"presets":[{"name":"آراء العملاء Qabs1","blocks":[{"type":"quote"},{"type":"quote"},{"type":"quote"}]}]}{% endschema %}
