<section class="main-product-v4"><div class="container product-layout"><div class="product-gallery">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}{% else %}{% render 'product-image-fallback', product_handle: product.handle, product_title: product.title, alt: product.title, loading: 'eager' %}{% endif %}</div><div class="product-info"><nav class="breadcrumbs"><a href="{{ routes.root_url }}">الرئيسية</a> / <span>{{ product.title }}</span></nav><h1>{{ product.title }}</h1><div class="product-price"><span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</div><div class="product-copy">{{ product.description }}</div>
{% form 'product', product, class: 'product-form-v4' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% unless product.has_only_default_variant %}<label>الخيار<select name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select></label>{% endunless %}<label>الكمية<input type="number" name="quantity" value="1" min="1"></label><button class="btn btn-primary btn-large product-submit" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}أضف إلى السلة{% else %}غير متوفر{% endif %}</button>{{ form | payment_button }}{% endform %}
<div class="product-promises"><span>✓ سعر واضح</span><span>✓ دفع آمن عبر Shopify</span><span>✓ متابعة الطلب من الحساب</span></div></div></div></section>
{% schema %}{"name":"المنتج الرئيسي Qabs1","settings":[],"presets":[{"name":"المنتج الرئيسي Qabs1"}]}{% endschema %}
