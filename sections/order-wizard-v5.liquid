<section class="wizard-section-v5"><div class="container"><div class="section-head"><span class="kicker">طلب موحد</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div>{% form 'contact', id:'QabsWizard', class:'order-wizard-v5' %}{% if form.posted_successfully? %}<div class="form-success">{{ section.settings.success_message }}</div>{% endif %}{% if form.errors %}<div class="order-errors">{{ form.errors | default_errors }}</div>{% endif %}<input type="hidden" name="contact[subject]" value="Qabs1 — طلب خدمة جديد">
<div class="wizard-progress" aria-label="تقدم الطلب"><span class="active">1 الخدمة</span><span>2 الباقة</span><span>3 البيانات</span><span>4 التفاصيل</span><span>5 المراجعة</span></div>
<div class="wizard-step active" data-step="1"><h2>ما الخدمة التي تحتاجها؟</h2><div class="choice-grid-v5">{% assign services='تأسيس الشركات,متجر Shopify,إدارة متجر,إدارة السوشل ميديا,موقع أو حل رقمي,هوية بصرية,بوابات دفع,حسابات بنكية,تمويل,طلب مخصص' | split:',' %}{% for service in services %}<label class="choice-card-v5"><input type="radio" name="contact[service]" value="{{ service }}" {% if forloop.first %}checked{% endif %}><span><b>{{ service }}</b><small>اختر للمتابعة وتخصيص الطلب.</small></span></label>{% endfor %}</div></div>
<div class="wizard-step" data-step="2"><h2>اختر الباقة</h2><div class="choice-grid-v5 compact"><label class="choice-card-v5"><input type="radio" name="contact[plan]" value="Starter"><span><b>Starter</b><small>للبدايات والنطاق المحدود.</small></span></label><label class="choice-card-v5"><input type="radio" name="contact[plan]" value="Business" checked><span><b>Business</b><small>الخيار المتوازن للمشاريع النامية.</small></span></label><label class="choice-card-v5"><input type="radio" name="contact[plan]" value="Professional"><span><b>Professional</b><small>نطاق متقدم ودعم أولوية.</small></span></label></div><fieldset class="addon-box-v5"><legend>إضافات اختيارية</legend><label><input type="checkbox" name="contact[addons]" value="استشارة أولوية"> استشارة أولوية</label><label><input type="checkbox" name="contact[addons]" value="دعم موسع"> دعم موسع</label><label><input type="checkbox" name="contact[addons]" value="تسليم سريع"> تسليم سريع</label></fieldset></div>
<div class="wizard-step" data-step="3"><h2>بيانات التواصل</h2><div class="form-grid-v5"><label>الاسم الكامل<input type="text" name="contact[name]" required autocomplete="name"></label><label>البريد الإلكتروني<input type="email" name="contact[email]" required autocomplete="email"></label><label>الهاتف / واتساب<input type="tel" name="contact[phone]" autocomplete="tel"></label><label>الدولة<input type="text" name="contact[country]" autocomplete="country-name"></label><label>اسم النشاط<input type="text" name="contact[business]"></label><label>الموقع الحالي إن وجد<input type="url" name="contact[website]" placeholder="https://"></label></div></div>
<div class="wizard-step" data-step="4"><h2>تفاصيل الطلب</h2><label class="full-field">اشرح ما تحتاجه<textarea name="contact[body]" required placeholder="النشاط، الهدف، الموعد المتوقع، وأي تفاصيل مهمة"></textarea></label><label class="full-field">الولاية الأمريكية إن كانت خدمة تأسيس<input type="text" name="contact[state]"></label><p class="upload-note">لا ترسل كلمات مرور أو رموز تحقق. قد تُشارك البيانات اللازمة مع الجهات الحكومية ومزودي الخدمات المعتمدين لتنفيذ الطلب وفق سياسة الخصوصية.</p></div>
<div class="wizard-step" data-step="5"><h2>راجع وأرسل</h2><div class="review-box-v5"><p>سيصل الطلب إلى فريق Qabs1 للمراجعة. لا يُعد إرسال النموذج التزامًا بالدفع.</p><ul><li>تأكيد النطاق والسعر قبل التنفيذ.</li><li>الرسوم الحكومية والخارجية تظهر منفصلة.</li><li>يمكنك الدفع من منتج Shopify أو رابط فاتورة آمن.</li><li>إرسال الطلب لا يضمن قبول جهة حكومية أو بنك أو مزود دفع.</li></ul></div><label class="order-consent"><input type="checkbox" required> أوافق على التواصل معي بخصوص الطلب وعلى سياسات الموقع.</label></div>
<div class="wizard-actions"><button class="btn btn-outline" type="button" data-prev hidden>السابق</button><button class="btn btn-primary" type="button" data-next>التالي</button><button class="btn btn-primary" type="submit" data-submit hidden>إرسال الطلب</button></div>{% endform %}</div></section>
{% schema %}{"name":"نموذج طلب Qabs1 المتعدد","settings":[{"type":"text","id":"heading","label":"العنوان","default":"ابدأ الآن بخمس خطوات"},{"type":"textarea","id":"text","label":"الوصف","default":"خصص الخدمة والباقة ثم أرسل طلبك للمراجعة قبل الدفع."},{"type":"text","id":"success_message","label":"رسالة النجاح","default":"تم استلام طلبك. سنتواصل معك لمراجعة النطاق والخطوة التالية."}],"presets":[{"name":"نموذج طلب Qabs1 المتعدد"}]}{% endschema %}
