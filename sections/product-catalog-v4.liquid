<section class="catalog-section" id="catalog"><div class="container"><div class="section-head"><span class="kicker">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
{% assign chosen_collection = section.settings.collection %}
{% if chosen_collection != blank and chosen_collection.products_count > 0 %}<div class="product-grid-v4">{% for product in chosen_collection.products limit: section.settings.limit %}<article class="shop-card"><a href="{{ product.url }}" class="shop-card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.title }}{% else %}{% render 'product-image-fallback', product_handle: product.handle, product_title: product.title, alt: product.title %}{% endif %}</a><small>{{ product.type | default: 'خدمة Qabs1' }}</small><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}<a class="btn btn-outline card-btn" href="{{ product.url }}">عرض الخدمة</a></article>{% endfor %}</div>{% else %}<div class="empty-catalog">اختر مجموعة منتجات من إعدادات هذا القسم لعرض خدماتك الحقيقية.</div>{% endif %}
{% if section.settings.button_label != blank %}<div class="section-action"><a class="btn btn-primary" href="{{ chosen_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} ←</a></div>{% endif %}</div></section>
{% schema %}
{"name":"كتالوج منتجات Qabs1","settings":[{"type":"text","id":"kicker","label":"الشارة","default":"الخدمات القابلة للدفع"},{"type":"text","id":"heading","label":"العنوان","default":"اختر الباقة المناسبة"},{"type":"textarea","id":"text","label":"الوصف","default":"منتجات Shopify حقيقية يمكن إضافتها للسلة والدفع."},{"type":"collection","id":"collection","label":"مجموعة المنتجات"},{"type":"range","id":"limit","label":"عدد المنتجات","min":4,"max":16,"step":1,"default":8},{"type":"text","id":"button_label","label":"زر الكل","default":"عرض كل الخدمات"}],"presets":[{"name":"كتالوج منتجات Qabs1"}]}
{% endschema %}
