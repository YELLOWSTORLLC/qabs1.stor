<section class="account-v5"><div class="container account-shell-v5"><div class="account-card-v5"><span class="kicker">حساب العميل</span>{% if section.settings.mode == 'register' %}<h1>إنشاء حساب</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label>الاسم الأول<input type="text" name="customer[first_name]" autocomplete="given-name"></label><label>اسم العائلة<input type="text" name="customer[last_name]" autocomplete="family-name"></label><label>البريد الإلكتروني<input type="email" name="customer[email]" required autocomplete="email"></label><label>كلمة المرور<input type="password" name="customer[password]" required autocomplete="new-password"></label><button class="btn btn-primary btn-large" type="submit">إنشاء الحساب</button>{% endform %}<p><a href="{{ routes.account_login_url }}">لديك حساب؟ سجّل الدخول</a></p>{% else %}<h1>تسجيل الدخول</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label>البريد الإلكتروني<input type="email" name="customer[email]" required autocomplete="email"></label><label>كلمة المرور<input type="password" name="customer[password]" required autocomplete="current-password"></label><button class="btn btn-primary btn-large" type="submit">تسجيل الدخول</button>{% endform %}<p><a href="{{ routes.account_register_url }}">إنشاء حساب جديد</a></p>{% endif %}</div></div></section>
{% schema %}{"name":"دخول وحساب Qabs1","settings":[{"type":"select","id":"mode","label":"الوضع","options":[{"value":"login","label":"تسجيل الدخول"},{"value":"register","label":"إنشاء حساب"}],"default":"login"}],"presets":[{"name":"دخول وحساب Qabs1"}]}{% endschema %}
