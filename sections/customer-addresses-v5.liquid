<section class="account-v5"><div class="container"><div class="account-head-v5"><div><span class="kicker">حساب العميل</span><h1>العناوين</h1></div><a class="btn btn-outline" href="{{ routes.account_url }}">العودة للحساب</a></div><div class="address-grid-v5">{% for address in customer.addresses %}<article><h2>{% if address == customer.default_address %}العنوان الافتراضي{% else %}عنوان {{ forloop.index }}{% endif %}</h2>{{ address | format_address }}{% form 'customer_address', address %}<input type="hidden" name="_method" value="delete"><button class="btn btn-outline" type="submit">حذف</button>{% endform %}</article>{% endfor %}<article><h2>إضافة عنوان</h2>{% form 'customer_address', customer.new_address %}{{ form.errors | default_errors }}<label>الاسم الأول<input type="text" name="address[first_name]"></label><label>اسم العائلة<input type="text" name="address[last_name]"></label><label>العنوان<input type="text" name="address[address1]"></label><label>المدينة<input type="text" name="address[city]"></label><label>الدولة<input type="text" name="address[country]"></label><label>الرمز البريدي<input type="text" name="address[zip]"></label><button class="btn btn-primary" type="submit">حفظ العنوان</button>{% endform %}</article></div></div></section>
{% schema %}{"name":"عناوين العميل Qabs1","settings":[],"presets":[{"name":"عناوين العميل Qabs1"}]}{% endschema %}
