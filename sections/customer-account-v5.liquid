<section class="account-v5"><div class="container"><div class="account-head-v5"><div><span class="kicker">بوابة العميل</span><h1>مرحبًا {{ customer.first_name | default: customer.name }}</h1></div><a class="btn btn-outline" href="{{ routes.account_logout_url }}">تسجيل الخروج</a></div><div class="account-layout-v5"><aside><a class="active" href="{{ routes.account_url }}">طلباتي</a><a href="{{ routes.account_addresses_url }}">العناوين</a><a href="/pages/contact">الدعم</a></aside><div><h2>الطلبات</h2>{% paginate customer.orders by 10 %}{% if customer.orders.size > 0 %}<div class="orders-table-v5"><div class="orders-row head"><span>الطلب</span><span>التاريخ</span><span>الحالة</span><span>الإجمالي</span></div>{% for order in customer.orders %}<a class="orders-row" href="{{ order.customer_url }}"><span>{{ order.name }}</span><span>{{ order.created_at | date:'%Y/%m/%d' }}</span><span>{{ order.fulfillment_status_label }}</span><span>{{ order.total_price | money }}</span></a>{% endfor %}</div>{% else %}<div class="empty-catalog">لا توجد طلبات بعد. <a href="{{ routes.all_products_collection_url }}">استكشف الخدمات</a></div>{% endif %}{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></div></section>
{% schema %}{"name":"حساب العميل Qabs1","settings":[],"presets":[{"name":"حساب العميل Qabs1"}]}{% endschema %}
