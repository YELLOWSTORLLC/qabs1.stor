<section class="account-v5"><div class="container account-shell-v5"><div class="account-card-v5"><a class="brand" href="{{ routes.root_url }}"><span class="logo"></span><span>{{ settings.brand_name | default: shop.name }}</span></a><span class="kicker">قريبًا</span><h1>{{ shop.name }}</h1><p>{{ shop.password_message | default: section.settings.text }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label>كلمة مرور المتجر<input type="password" name="password" required autocomplete="current-password"></label><button class="btn btn-primary" type="submit">دخول</button>{% endform %}</div></div></section>
{% schema %}{"name":"صفحة كلمة المرور","settings":[{"type":"textarea","id":"text","label":"الوصف","default":"نعمل على تجهيز تجربة أفضل. عد قريبًا."}],"presets":[{"name":"صفحة كلمة المرور"}]}{% endschema %}
