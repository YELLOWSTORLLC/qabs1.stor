<section class="order-section" id="order"><div class="container"><div class="section-head"><div class="kicker">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
  {% form 'contact', id: 'Qabs1OrderForm', class: 'qabs-order-form' %}
    {% if form.posted_successfully? %}<div class="order-success">{{ section.settings.success_message }}</div>{% endif %}
    {% if form.errors %}<div class="order-errors">{{ form.errors | default_errors }}</div>{% endif %}
    <input type="hidden" name="contact[subject]" value="Qabs1 — طلب خدمة جديد">
    <div class="order-grid">
      <label>الاسم الكامل<input type="text" name="contact[name]" required autocomplete="name" placeholder="اكتب اسمك"></label>
      <label>البريد الإلكتروني<input type="email" name="contact[email]" required autocomplete="email" placeholder="you@example.com"></label>
      <label>رقم الهاتف<input type="tel" name="contact[phone]" autocomplete="tel" placeholder="+1 ..."></label>
      <label>الخدمة المطلوبة<select name="contact[service]" required><option value="">اختر الخدمة</option><option>تأسيس الشركات</option><option>حلول رقمية متكاملة</option><option>متاجر ومنصات</option><option>هويات بصرية</option><option>بوابات دفع</option><option>حسابات بنكية وبطاقات</option><option>إدارة متاجر</option><option>إدارة الأسئلة</option><option>إدارة مواقع التواصل الاجتماعي</option><option>تمويل التجارة الإلكترونية</option></select></label>
      <label>ولاية التأسيس<select name="contact[state]"><option value="">اختر الولاية إن وجدت</option>{% assign states = 'Alabama|ألاباما,Alaska|ألاسكا,Arizona|أريزونا,Arkansas|أركنساس,California|كاليفورنيا,Colorado|كولورادو,Connecticut|كونيتيكت,Delaware|ديلاوير,Florida|فلوريدا,Georgia|جورجيا,Hawaii|هاواي,Idaho|أيداهو,Illinois|إلينوي,Indiana|إنديانا,Iowa|آيوا,Kansas|كانساس,Kentucky|كنتاكي,Louisiana|لويزيانا,Maine|مين,Maryland|ماريلاند,Massachusetts|ماساتشوستس,Michigan|ميشيغان,Minnesota|مينيسوتا,Mississippi|ميسيسيبي,Missouri|ميزوري,Montana|مونتانا,Nebraska|نبراسكا,Nevada|نيفادا,New Hampshire|نيوهامبشر,New Jersey|نيوجيرسي,New Mexico|نيومكسيكو,New York|نيويورك,North Carolina|نورث كارولاينا,North Dakota|نورث داكوتا,Ohio|أوهايو,Oklahoma|أوكلاهوما,Oregon|أوريغون,Pennsylvania|بنسلفانيا,Rhode Island|رود آيلاند,South Carolina|ساوث كارولاينا,South Dakota|ساوث داكوتا,Tennessee|تينيسي,Texas|تكساس,Utah|يوتا,Vermont|فيرمونت,Virginia|فرجينيا,Washington|واشنطن,West Virginia|ويست فرجينيا,Wisconsin|ويسكونسن,Wyoming|وايومنغ' | split: ',' %}{% for state in states %}{% assign pair = state | split: '|' %}<option value="{{ pair[0] }}">{{ pair[1] }} — {{ pair[0] }}</option>{% endfor %}</select></label>
      <label>الباقة<select name="contact[plan]"><option>Starter</option><option selected>Essentials</option><option>Supreme</option><option>لا أعرف — أحتاج استشارة</option></select></label>
    </div>
    <label class="order-wide">تفاصيل الطلب<textarea name="contact[body]" required placeholder="اكتب تفاصيل نشاطك وما تحتاجه..."></textarea></label>
    <label class="order-consent"><input type="checkbox" required> أوافق على التواصل معي بخصوص هذا الطلب.</label>
    <button class="btn btn-primary" type="submit">إرسال الطلب <span>←</span></button>
  {% endform %}
</div></section>
{% schema %}
{"name":"Order Form Qabs1","settings":[{"type":"text","id":"kicker","label":"العنوان الصغير","default":"ابدأ طلبك"},{"type":"text","id":"heading","label":"العنوان","default":"خطوة واحدة تفصلك عن البداية"},{"type":"textarea","id":"text","label":"الوصف","default":"أرسل التفاصيل الأولية وسيتواصل معك فريق Qabs1 لمراجعتها."},{"type":"text","id":"success_message","label":"رسالة النجاح","default":"تم استلام طلبك. سيتواصل معك فريق Qabs1 قريبًا."}],"presets":[{"name":"Order Form Qabs1"}]}
{% endschema %}
